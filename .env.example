# Copy this file to .env (same folder) and fill in the values. .env is in .gitignore and must never be committed.

# JWT signing key (HMAC-SHA512): a random string of at least 64 bytes.
# Generate one with:  openssl rand -base64 64
# Keep the single quotes: base64 contains characters (+ / =) that must be quoted.
AppSettings__Token=''

# SQL Server "sa" password, only used by docker-compose.yml.
# At least 8 characters with 3 of: uppercase, lowercase, digits, symbols. Don't use ; or ' (it goes into a connection string).
MSSQL_SA_PASSWORD=''
